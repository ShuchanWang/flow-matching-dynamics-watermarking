# Paper repository allowlist. Local scratch files, notebooks, datasets, and
# checkpoints stay on disk but are not tracked for the public repo.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/LICENSE
!/Coded_Transport_Watermark_large.py
!/Coded_Transport_Watermark_UNet.py
!/paper/
!/paper/main.tex
!/paper/ref.bib
!/paper/outputs/
!/paper/outputs/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/

# IDE and notebooks
.idea/
.vscode/
.ipynb_checkpoints/

# Data, checkpoints, and generated artifacts
data/
checkpoints/
checkpointsCIFAR/
outputs/
experiment/
flow_matching/examples/image/data/
flow_matching/examples/image/output_dir/

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# System files
.DS_Store
