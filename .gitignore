# Paper repository allowlist. Local scratch files, downloaded data,
# checkpoints, and generated outputs stay on disk but are not tracked.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/LICENSE
!/flow_watermark_mnist_mlp.py
!/flow_watermark_unet_lora.py
!/paper/
!/paper/main.tex
!/paper/ref.bib
!/paper/outputs/
!/paper/outputs/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/

# IDE and notebooks
.idea/
.vscode/
.ipynb_checkpoints/

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# System files
.DS_Store
