!/test_main_architectures.py
!/paper/
!/paper/main.tex
!/paper/ref.bib
!/paper/outputs/
!/paper/outputs/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/

# IDE and notebooks
.idea/
.vscode/
.ipynb_checkpoints/

# LaTeX build artifacts
/paper/main.pdf
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# System files
!/run_audio_ownership.py
!/test_audio_ownership.py
!/finalize_audio_ownership.py
