# Paper repository allowlist. Local scratch files, downloaded data,
# checkpoints, and generated outputs stay on disk but are not tracked.
/*
!/.gitignore
!/README.md
!/run_endpoint_loop_training.py
!/test_endpoint_loop_training.py
!/audit_endpoint_loop_training.py
!/run_endpoint_loop_distillation.py
!/test_endpoint_loop_distillation.py
!/requirements.txt
!/LICENSE
!/flow_watermark_mnist_mlp.py
!/flow_watermark_unet_lora.py
!/watermark_hf_flow_unet.py
!/watermark_sd35.py
!/run_table_experiments.py
!/collect_results.py
!/audit_saved_metrics.py
!/evaluate_embedding_budget.py
!/run_adaptive_study.py
!/watermark_codebooks.py
!/prepare_audio_latents.py
!/download_audio_datasets.py
!/diagnose_sd35_hypercube.py
!/repair_mlp_watermarks.py
