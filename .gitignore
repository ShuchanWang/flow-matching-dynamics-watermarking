# Reviewed sources and compact evidence only. Full research artifacts stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/run.py
!/repo_layout.py
!/test_repo_layout.py
!/requirements*.txt
!/baseline_protocol.md
!/models/
!/experiments/
!/tools/
!/docs/
!/results/
!/paper/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# Compact exported evidence only, never weights or owner keys.
/results/**/*
!/results/**/
!/results/**/*.json
!/results/**/*.csv
!/results/**/*.md

# Manuscript sources and referenced figures.
/paper/*
!/paper/main.tex
!/paper/ref.bib
!/paper/performance_results.tex
!/paper/figures/
/paper/figures/*
!/paper/figures/sd35_clean_watermarked_trained_v2.pdf
!/paper/figures/payload_query_scaling.pdf
